# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas - Replace with your connection string
# Get it at: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/virtualdate?retryWrites=true&w=majority

# JWT Secret - Replace with a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Agora.io - Get at: https://www.agora.io/en/
# Only needed for video/voice calls
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Cloudinary - Get at: https://cloudinary.com
# Only needed for avatar uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
