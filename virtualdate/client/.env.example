# Oedg Client Environment Configuration
# When deploying to Vercel, set these in Project Settings -> Environment Variables

# The URL of your deployed Oedg backend (e.g. Render, Railway, Fly.io, or VPS)
VITE_API_URL=https://your-backend-service.onrender.com/api
VITE_SOCKET_URL=https://your-backend-service.onrender.com

# Optional: Agora.io App ID (falls back to WebRTC peer-to-peer if omitted)
VITE_AGORA_APP_ID=your_agora_app_id
